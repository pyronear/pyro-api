FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT="/opt/venv"

ARG UV_GROUPS="inference"

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /bin/uv
COPY pyproject.toml uv.lock /app/
COPY client/pyproject.toml /app/client/pyproject.toml

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-editable --no-dev \
    $(for group in $UV_GROUPS; do printf " --only-group %s" "$group"; done)

FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"
ENV PATH="/opt/venv/bin:$PATH"

RUN apt-get -y update \
    && apt-get -y install --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app src/inference /app/inference

USER app

CMD ["sh", "-c", "exec uvicorn inference.main:app --host 0.0.0.0 --port 5051 --workers ${INFERENCE_WORKERS:-1}"]
